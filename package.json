    "preview": "vite preview --port 4329"
  },
  "dependencies": {
    "@fluentui/web-components": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
