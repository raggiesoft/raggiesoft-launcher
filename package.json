{
  "name": "raggiesoft-launcher-web",
  "version": "1.0.0",
  "private": true,
  "description": "RaggieSoft Launcher companion portal (launcher.raggiesoft.com) — Microsoft Fluent UI Web Components (FAST Element) + TypeScript + Vite Static SSG",
  "type": "module",
  "license": "MIT",
  "scripts": {
